D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "source": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "import pandas as pd\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.model_selection import train_test_split\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.preprocessing import StandardScaler\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.neighbors import KNeighborsClassifier\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.metrics import f1_score, confusion_matrix\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from imblearn.under_sampling import (\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    TomekLinks, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    EditedNearestNeighbours, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    CondensedNearestNeighbour, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    ClusterCentroids\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    ")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 1. Define features and target\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X = df_highly_imbalanced.drop('FGC-FGC_TL_Zone', axis=1)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "y = df_highly_imbalanced['FGC-FGC_TL_Zone']\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 2. Train-test split (70/30) with stratification\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_train, X_test, y_train, y_test = train_test_split(\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    X, y, test_size=0.3, random_state=42, stratify=y\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    ")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Count initial majority class in the training set\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "initial_majority_count = sum(y_train == 1.0)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(f\"Initial majority class (1.0) count in train set: {initial_majority_count}\\n\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 3. MUST DO: Feature Scaling before resampling\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "scaler = StandardScaler()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_train_scaled = scaler.fit_transform(X_train)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_test_scaled = scaler.transform(X_test)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 4. Define the undersampling algorithms\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "undersamplers = {\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \"Tomek Links\": TomekLinks(),\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \"Edited Nearest Neighbours\": EditedNearestNeighbours(),\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \"Condensed Nearest Neighbour\": CondensedNearestNeighbour(random_state=42),\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \"Cluster Centroids\": ClusterCentroids(random_state=42)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "}\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 5. Iterate, resample, train, and evaluate\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "for name, sampler in undersamplers.items():\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Resample using the SCALED training data\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    X_train_res, y_train_res = sampler.fit_resample(X_train_scaled, y_train)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Check the new size of the majority class\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    new_majority_count = sum(y_train_res == 1.0)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Train KNN\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    knn = KNeighborsClassifier()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    knn.fit(X_train_res, y_train_res)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Predict using the SCALED test data\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    y_pred = knn.predict(X_test_scaled)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    f1 = f1_score(y_test, y_pred, pos_label=0)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Explicitly set labels: [Negative Class (1.0), Positive Class (0.0)]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    tn, fp, fn, tp = confusion_matrix(y_test, y_pred, labels=[1.0, 0.0]).ravel()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    tpr = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    tnr = tn / (tn + fp) if (tn + fp) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    fpr = fp / (fp + tn) if (fp + tn) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    fnr = fn / (fn + tp) if (fn + tp) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Output results for the current algorithm\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    print(f\"--- {name} ---\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    print(f\"Majority class reduced to: {new_majority_count} rows\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    print(f\"F1 Score: {f1:.4f}\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    print(f\"TPR: {tpr:.4f} | TNR: {tnr:.4f} | FPR: {fpr:.4f} | FNR: {fnr:.4f}\\n\")"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ]

