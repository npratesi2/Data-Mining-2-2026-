D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ],

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "source": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.model_selection import train_test_split\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.preprocessing import StandardScaler\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.neighbors import KNeighborsClassifier\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.metrics import f1_score, accuracy_score, confusion_matrix\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 1. Prepare Features and Target\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "target_col = 'FGC-FGC_TL_Zone'\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_data = df_highly_imbalanced.drop(columns=[target_col]).values\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "y_data = df_highly_imbalanced[target_col].values\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 2. Train-Test Split (70/30)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_train, X_test, y_train, y_test = train_test_split(\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    X_data, y_data, test_size=0.30, random_state=42, stratify=y_data\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    ")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 3. Feature Scaling (Essential for KNN)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "scaler = StandardScaler()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_train = scaler.fit_transform(X_train)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_test = scaler.transform(X_test)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 4. Initialize and Train KNN\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Calculating sqrt of total dataset rows as requested\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "k_neighbors = int(np.sqrt(df_highly_imbalanced.shape[0]))\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "knn = KNeighborsClassifier(n_neighbors=k_neighbors)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "knn.fit(X_train, y_train)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 5. Predictions\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "y_pred = knn.predict(X_test)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 6. Calculate Metrics\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "accuracy = accuracy_score(y_test, y_pred)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "f1 = f1_score(y_test, y_pred, pos_label=0)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Extract True Negative, False Positive, False Negative, True Positive\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "tn, fp, fn, tp = confusion_matrix(y_test, y_pred, labels=[1.0, 0.0]).ravel()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# TPR (Sensitivity / Recall) and FPR rates\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "tpr = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "tnr = tn / (tn + fp) if (tn + fp) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "fpr = fp / (fp + tn) if (fp + tn) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "fnr = fn / (fn + tp) if (fn + tp) > 0 else 0.0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# 7. Print Results\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(f\"Number of neighbors (K): {k_neighbors}\")\n",

