D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# OVERSAMPLING THE MINORITY CLASSES USING SMOTE\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from imblearn.over_sampling import SMOTE\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Initialize SMOTE with a custom sampling strategy to prevent overfitting\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# This tells SMOTE exactly how many samples to generate for each class.\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "custom_strategy = {\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    1.0: 2000,\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    2.0: 2000,\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    3.0: 1000\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "}\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "smote = SMOTE(sampling_strategy=custom_strategy, random_state=42)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "X_train_resampled, y_train_resampled = smote.fit_resample(X_train, y_train)"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ]

