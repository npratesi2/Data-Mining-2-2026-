D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "metadata": {},

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "outputs": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    {

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->     "name": "stdout",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->     "output_type": "stream",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->     "text": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "--- 2. SETUP SPIEGAZIONE LOCALE ---\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "Selezionata Istanza Indice: 26\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "Classe Reale: 3 (Severe)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "Classe Predetta dalla Rete: 3 (Severe)\n"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->     ]

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    }

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ],

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "source": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# [2. Instance Selection]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Selezioniamo un'istanza in cui la Rete Neurale ha predetto una classe minoritaria\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# (es. classe 3 = Dipendenza Severa, oppure classe 2).\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(\"\\n--- 2. SETUP SPIEGAZIONE LOCALE ---\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Cerchiamo gli indici nel test set dove il modello ha predetto la classe 3 o 2\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "minority_class_indices = np.where(y_pred == 3)[0]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "if len(minority_class_indices) > 0:\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    target_idx = minority_class_indices[0]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "else:\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Fallback: prendiamo una riga a caso se non ci sono classi minoritarie predette\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    target_idx = 0 \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "instance_scaled = X_test[target_idx].reshape(1, -1)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "predicted_class = y_pred[target_idx]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "true_class = y_test[target_idx]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(f\"Selezionata Istanza Indice: {target_idx}\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(f\"Classe Reale: {class_names[int(true_class)]}\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(f\"Classe Predetta dalla Rete: {class_names[predicted_class]}\")"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ]

