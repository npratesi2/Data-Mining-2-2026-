D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ],

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "source": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# [3. SHAP Local & Global]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Spiegazione tramite Feature Attribution usando i valori di Shapley\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(\"\\n--- 3. SPIEGAZIONE SHAP (Feature Attribution) ---\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Inizializziamo l'Explainer di SHAP\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "background_data = shap.sample(X_train_resampled, 100, random_state=42)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "def f_predict(x):\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    return best_model.predict(x, verbose=0)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "explainer = shap.KernelExplainer(f_predict, background_data)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Calcoliamo gli SHAP values per la singola istanza\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "shap_values_instance = explainer.shap_values(instance_scaled, silent=True)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# GESTIONE COMPATIBILITA' VERSIONI SHAP\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "if isinstance(shap_values_instance, list):\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # SHAP < 0.40: lista di array, prendiamo l'array della classe predetta e la riga 0\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    shap_vals = shap_values_instance[predicted_class][0]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "else:\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # SHAP >= 0.40: array 3D (n_samples, n_features, n_classes)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Selezioniamo il sample 0, tutte le feature (:), e la classe predetta\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    shap_vals = shap_values_instance[0, :, predicted_class]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "expected_value = explainer.expected_value[predicted_class]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Costruiamo l'oggetto Explanation per i plot più moderni di SHAP (come waterfall)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "explanation = shap.Explanation(values=shap_vals,\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "                               base_values=expected_value,\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "                               data=instance_scaled[0],\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "                               feature_names=feature_names)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Plot LOCALE (Waterfall Plot)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.figure()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "shap.waterfall_plot(explanation, show=False)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.title(f\"SHAP Waterfall Plot Locale (Previsione: {class_names[predicted_class]})\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.tight_layout()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.show()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Plot GLOBALE (Summary Plot) su un sottoinsieme del Test Set per efficienza\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "test_subset = X_test[:150]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "shap_values_global = explainer.shap_values(test_subset, silent=True)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Assicuriamoci che il summary plot multiclasse riceva il formato giusto\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "if not isinstance(shap_values_global, list) and len(shap_values_global.shape) == 3:\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    # Se è un array 3D, lo trasformiamo in una lista di array 2D per il summary_plot\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "    shap_values_global = [shap_values_global[:, :, i] for i in range(shap_values_global.shape[2])]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.figure()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "shap.summary_plot(shap_values_global, test_subset, feature_names=feature_names, class_names=class_names, show=False)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.title(\"SHAP Summary Plot Globale sul Test Set\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.tight_layout()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.show()"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ]

