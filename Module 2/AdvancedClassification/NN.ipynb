D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'FGC-FGC_CU_Zone' da 0.00 a -0.07\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'FGC-FGC_PU_Zone' da 0.00 a 0.11\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'FGC-FGC_SRL_Zone' da 1.00 a 0.92\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'FGC-FGC_SRR_Zone' da 1.00 a 1.08\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_BMC' da 4.24 a 7.11\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_BMI' da 17.97 a 17.12\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_BMR' da 1115.38 a 1185.45\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_ECW' da 15.93 a 22.26\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_FFM' da 61.07 a 71.94\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_FFMI' da 14.09 a 15.92\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_FMI' da 4.13 a 3.72\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_Fat' da 16.17 a 2.55\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_Frame_num' da 2.00 a 1.94\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_ICW' da 28.86 a 22.93\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_LDM' da 16.44 a 15.25\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_LST' da 57.81 a 70.62\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'BIA-BIA_SMM' da 27.42 a 37.31\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'BIA-BIA_TBW' da 44.99 a 38.58\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - diminuire 'PAQ_A-PAQ_A_Total' da 2.01 a 1.96\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->      "  - aumentare 'PAQ_C-PAQ_C_Total' da 2.70 a 2.75\n",

