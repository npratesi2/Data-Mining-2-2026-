D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->     "output_type": "display_data"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    }

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ],

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   "source": [

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# [1. TREPAN Global / Surrogato Globale]\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Addestriamo un Albero Decisionale per approssimare il comportamento globale \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# della Rete Neurale (Black Box).\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# ==============================================================================\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "print(\"\\n--- 1. SPIEGAZIONE GLOBALE (Global Surrogate) ---\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Utilizziamo le predizioni della Rete Neurale sul test set come target per l'albero\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "global_surrogate = DecisionTreeClassifier(max_depth=4, random_state=42)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "global_surrogate.fit(X_test, y_pred) # y_pred sono le etichette predette dal best_model\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "# Plot dell'albero decisionale globale\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.figure(figsize=(20, 10))\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plot_tree(global_surrogate, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "          feature_names=feature_names, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "          class_names=class_names, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "          filled=True, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "          rounded=True, \n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "          fontsize=10)\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.title(\"Albero Decisionale Surrogato Globale (Approssimazione della Rete Neurale)\")\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.tight_layout()\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "plt.show()"

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->   ]

