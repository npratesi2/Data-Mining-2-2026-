D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "import matplotlib.pyplot as plt\n",

D:\UniPi\Semester 1\420AA Data Mining\Project DM2\Data-Mining-2-2026->    "from sklearn.metrics import classification_report, roc_curve, auc\n",

